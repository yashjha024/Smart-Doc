APP_NAME=FileCraft
APP_VERSION=0.1.0

# In development, you can use SQLite.
# In production (ENVIRONMENT=production), you MUST provide a valid PostgreSQL DATABASE_URL.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./docrename.db
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

STORAGE_ROOT=local_data
# Uploaded and processed files are deleted after this many minutes
FILE_TTL_MINUTES=60
# How often the cleanup runs
CLEANUP_INTERVAL_MINUTES=10
# Largest accepted upload
MAX_UPLOAD_MB=50
# How many jobs run at the same time
JOB_WORKERS=3
# Optional: full path to gswin64c.exe / gs if it isn't found automatically
# GHOSTSCRIPT_PATH=C:\Program Files\gs\gs10.04.0\bin\gswin64c.exe

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
